# Copy this file to `.env` and fill in your own credentials.
# `.env` is gitignored. Never paste these values into chat, a notebook, or a commit.

# ---------------------------------------------------------------------------
# 1. Planet Insights Platform (Sentinel Hub APIs: Statistical, Catalog, Process)
#    Get these from https://insights.planet.com -> user settings -> OAuth clients.
#    Create a new OAuth client; the secret is shown ONCE, so save it immediately.
#    These are what the NDVI pipeline uses. This is the important pair.
# ---------------------------------------------------------------------------
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Verified 2026-08-17: this account authenticates against the EU (Frankfurt)
# deployment. The US-West endpoint returns 503 for it. steps/00_check_access.py
# tries both and reports which one answers, so you don't have to guess.
SH_BASE_URL=https://services.sentinel-hub.com
SH_AUTH_BASE_URL=https://services.sentinel-hub.com

# ---------------------------------------------------------------------------
# 2. Planet classic APIs (Data / Orders / Subscriptions / Basemaps)
#    This is the older-style key from https://www.planet.com/account/#/user-settings
#    Only needed when ordering actual PlanetScope scenes (Week 2+ / case study).
# ---------------------------------------------------------------------------
PL_API_KEY=
